# Google Ads ClaudePRO - Configuracao (MODELO)
#
# Copie este arquivo para `.env` na mesma pasta e preencha os valores:
#   cp .env.example .env
#
# O `.env` esta no .gitignore e nunca vai pro GitHub. Este `.env.example`
# vai, e por isso nao pode ter nenhum valor real dentro.
#
# Os scripts leem o `.env` automaticamente. NAO precisa adicionar ao ~/.zshrc.

# OBRIGATORIO: credenciais OAuth do seu projeto no Google Cloud Console
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""

# OBRIGATORIO: gerado automaticamente por `python3 scripts/setup.py oauth`
GOOGLE_ADS_REFRESH_TOKEN=""

# OPCIONAL: ID do MCC, so se voce consulta contas atraves de uma conta gerenciadora.
# Sempre sem hifens (1234567890, nao 123-456-7890).
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

# OPCIONAL: conta padrao (evita passar --customer-id toda vez). Sem hifens.
GOOGLE_ADS_CUSTOMER_ID=""

# OPCIONAL E APOSENTADO: o Google aposentou os developer tokens em 09/09/2026.
# Quem manda no nivel de acesso agora e o projeto do Google Cloud que gerou as
# credenciais OAuth acima. Deixe vazio. So preencha se voce ja tinha um token
# antigo e quer manter (ele e aceito no header, mas ignorado pelo servidor).
GOOGLE_ADS_DEVELOPER_TOKEN=""
